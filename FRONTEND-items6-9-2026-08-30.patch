From e10d969a73a4d9ccf41c281b5a4b0588b09cf372 Mon Sep 17 00:00:00 2001
From: Usty <usty@uase.tech>
Date: Sun, 30 Aug 2026 16:16:40 +0000
Subject: [PATCH 3/4] fix: block car listing submission without at least one
 photo (checklist item 6, frontend)

The primary fix for the two-step creation flow gap (car record
created first, photos uploaded separately after) - handleSave now
checks images.length===0 alongside the existing model/price checks,
with a clear message, before it will call the create or update
endpoint. Applied uniformly to both adding a new car and editing an
existing one, so removing every photo during an edit and trying to
save is blocked the same way.

Staff needed no separate change - staff/inventory/page.tsx already
dynamically imports this exact same dealer page, so the fix covers
both roles automatically.

Backend commit alongside this one adds the matching server-side
safety net on the public-facing endpoints, in case anything ever
bypasses this client-side check.
---
 app/dashboard/dealer/cars/page.tsx | 1 +
 1 file changed, 1 insertion(+)

diff --git a/app/dashboard/dealer/cars/page.tsx b/app/dashboard/dealer/cars/page.tsx
index da3d351..4cf0672 100644
--- a/app/dashboard/dealer/cars/page.tsx
+++ b/app/dashboard/dealer/cars/page.tsx
@@ -246,6 +246,7 @@ export default function DealerCarsPage() {
   const handleSave = async()=>{
     if(!form.model.trim()){showErr("Vehicle model is required");return;}
     if(!form.sellingPrice){showErr("Selling price is required");return;}
+    if(images.length===0){showErr("Add at least one photo before posting this vehicle");return;}
     setSaving(true);setErr("");
     try {
       const payload={...form,year:Number(form.year),sellingPrice:Number(form.sellingPrice),purchasePrice:Number(form.purchasePrice)||0,promoPrice:Number(form.promoPrice)||0,mileage:Number(form.mileage)||0};
-- 
