From 77e1283d66b24bb356d8eb2452c2b85a63df7ce5 Mon Sep 17 00:00:00 2001
From: Usty <usty@uase.tech>
Date: Sun, 30 Aug 2026 16:27:32 +0000
Subject: [PATCH 4/4] fix: dealer name on feed cards now links to their profile
 page (checklist item 9)

Real gap confirmed: the dealer-strip shown on every car card (logo +
company name) was a plain, non-clickable div, despite the same
information on the car detail page already correctly linking to the
dealer's profile.

Added dealerId to the Car interface - the backend already sends it
on every car (serialize_doc passes every field through generically,
confirmed the field is genuinely stored on each car document), it
just wasn't declared in this type. Made the strip clickable via
stopPropagation + router.push rather than a nested Link, since the
whole card is already an anchor and nesting interactive elements
inside one is invalid HTML - same reasoning already applied
elsewhere this session (the inline comment box, the admin delete
button).

Confirmed the car detail page's own dealer name display already
correctly links to the profile via a real Link (safe there, since
it isn't nested inside another anchor) - no change needed there.

Item 7 (search by dealer ID) and item 8 (company-name search
surfaces that dealer's cars) already landed in separate commits -
this completes the full dealer search request (items 7, 8, 9).
---
 app/feed/page.tsx | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/app/feed/page.tsx b/app/feed/page.tsx
index fafde02..6513d49 100644
--- a/app/feed/page.tsx
+++ b/app/feed/page.tsx
@@ -42,7 +42,7 @@ interface Car {
   color:string; sellingPrice:number; promoPrice?:number; status:string;
   images:string[]; viewCount:number; likeCount:number; commentCount?:number;
   city?:string; state?:string; transmission?:string; fuelType?:string;
-  dealerName?:string; dealerLogo?:string; condition?:string;
+  dealerName?:string; dealerLogo?:string; dealerId?:string; condition?:string;
 }
 
 export default function FeedPage() {
@@ -776,7 +776,11 @@ export default function FeedPage() {
                 </div>
 
                 {car.dealerName && (
-                  <div className="dealer-strip">
+                  <div
+                    className="dealer-strip"
+                    onClick={(e) => { e.preventDefault(); e.stopPropagation(); if (car.dealerId) router.push(`/dealers/${car.dealerId}`); }}
+                    style={{ cursor: car.dealerId ? "pointer" : "default" }}
+                  >
                     <div className="ds-logo">{car.dealerLogo?<img src={car.dealerLogo} alt=""/>:car.dealerName?.charAt(0)||"D"}</div>
                     <span className="ds-name">{car.dealerName}</span>
                     {car.state && <span className="ds-loc">{car.state}</span>}
