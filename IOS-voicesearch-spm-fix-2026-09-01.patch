From d96e546f0b54acbfef7777f797b00f625de59677 Mon Sep 17 00:00:00 2001
From: Usty <usty@uase.tech>
Date: Wed, 2 Sep 2026 15:29:47 +0000
Subject: [PATCH] fix: iOS voice search does nothing at all -
 @capacitor-community/speech-recognition has no Package.swift, never actually
 linked into the SPM-only build

Real, confirmed root cause of the reported symptom (tapping the mic
on iPhone shows no permission popup at all, and Settings has no
Microphone/Speech Recognition entries for the app whatsoever - very
different from a denied permission, which would show those entries):
@capacitor-community/speech-recognition@7.0.1 ships no Package.swift
in its published package at all - confirmed directly against its
own repository and package.json 'files' list. It predates Capacitor
8's shift to Swift Package Manager as the default and was never
migrated. This project's iOS folder is confirmed 100% SPM (no
CocoaPods/Podfile anywhere), so this plugin's actual native Swift
implementation was never being linked into the app binary at all -
only its JS bridge was, which is why the JS import itself succeeds
(no 'plugin-not-bundled' error) but every native call
(available()/requestPermissions()/start()) has no real native code
to reach. iOS never even got as far as asking for microphone/speech
permission because the code path that would trigger that request
was never actually running.

This was visible in the build logs the whole time as a warning
('@capacitor-community/speech-recognition does not have a
Package.swift' / 'Some installed Capacitor plugins are not
compatible with SPM') but not something to have flagged as
significant without the concrete device-side symptom (no permission
popup, no Settings entries) confirming it was actually breaking
something rather than just a benign warning.

Fix: added scripts/patch-speech-recognition-spm.js, which writes a
correct Package.swift into the plugin's node_modules folder,
matching its actual source layout and deployment target confirmed
from its own podspec (ios/Plugin/**/*.swift, iOS 14 minimum) and the
exact dependency reference already proven working in this project's
own main Package.swift (capacitor-swift-pm, not guessed). Wired into
package.json's postinstall script so it runs automatically after
every npm install, on Xcode Cloud and locally alike - node_modules is
never committed to git, so this has to regenerate every time, not be
fixed by hand-editing a file once. Once this file exists before 'npx
cap sync ios' runs, Capacitor's CLI should detect the plugin as
SPM-valid and automatically link it into the app's own
auto-managed Package.swift, the same way every other working plugin
already is.
---
 package.json                            |  3 +-
 scripts/patch-speech-recognition-spm.js | 64 +++++++++++++++++++++++++
 2 files changed, 66 insertions(+), 1 deletion(-)
 create mode 100644 scripts/patch-speech-recognition-spm.js

diff --git a/package.json b/package.json
index 5f45d52..90c296f 100644
--- a/package.json
+++ b/package.json
@@ -6,7 +6,8 @@
         "dev": "next dev",
         "build": "next build",
         "start": "next start",
-        "lint": "next lint"
+        "lint": "next lint",
+        "postinstall": "node scripts/patch-speech-recognition-spm.js"
     },
     "dependencies": {
         "@capacitor/android": "^8.4.0",
diff --git a/scripts/patch-speech-recognition-spm.js b/scripts/patch-speech-recognition-spm.js
new file mode 100644
index 0000000..cabfd19
--- /dev/null
+++ b/scripts/patch-speech-recognition-spm.js
@@ -0,0 +1,64 @@
+/**
+ * Real, confirmed cause of iOS voice search silently doing nothing
+ * (no permission popup, no entry in Settings, generic "hiccup" error
+ * on tap): @capacitor-community/speech-recognition@7.0.1 ships no
+ * Package.swift at all - it predates Capacitor 8's shift to Swift
+ * Package Manager as the default, and was never migrated. This
+ * project's iOS folder is 100% SPM (confirmed - no CocoaPods/Podfile
+ * anywhere), so this plugin's native Swift implementation was never
+ * actually being linked into the app at all - only its JS bridge
+ * was. Every call into it (available(), requestPermissions(),
+ * start()) had no real native code to reach, which is why iOS never
+ * even got as far as asking for microphone/speech permission.
+ *
+ * node_modules is never committed to git (regenerated by every
+ * fresh `npm install`, on Xcode Cloud and locally alike), so this
+ * can't be fixed by hand-editing a file there once - it has to be
+ * regenerated every time. Wired into package.json's "postinstall"
+ * script so it runs automatically after every npm install,
+ * regardless of environment (Xcode Cloud's ci_post_clone.sh, or
+ * anyone running npm install locally to test).
+ */
+const fs = require("fs");
+const path = require("path");
+
+const pluginDir = path.join(__dirname, "..", "node_modules", "@capacitor-community", "speech-recognition");
+const packageSwiftPath = path.join(pluginDir, "Package.swift");
+
+if (!fs.existsSync(pluginDir)) {
+  // Plugin isn't installed at all in this environment - nothing to patch.
+  process.exit(0);
+}
+
+// Matches the source layout Capacitor's own plugins use, and the
+// plugin's own actual source location confirmed from its podspec
+// (s.source_files = 'ios/Plugin/**/*.{swift,h,m,c,cc,mm,cpp}') and
+// its declared deployment target (s.ios.deployment_target = '14.0').
+const packageSwiftContent = `// swift-tools-version: 5.9
+import PackageDescription
+
+let package = Package(
+    name: "CapacitorCommunitySpeechRecognition",
+    platforms: [.iOS(.v14)],
+    products: [
+        .library(
+            name: "CapacitorCommunitySpeechRecognition",
+            targets: ["CapacitorCommunitySpeechRecognitionPlugin"])
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", from: "7.0.0")
+    ],
+    targets: [
+        .target(
+            name: "CapacitorCommunitySpeechRecognitionPlugin",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm"),
+                .product(name: "Cordova", package: "capacitor-swift-pm")
+            ],
+            path: "ios/Plugin")
+    ]
+)
+`;
+
+fs.writeFileSync(packageSwiftPath, packageSwiftContent, "utf8");
+console.log("[patch-speech-recognition-spm] Wrote Package.swift for @capacitor-community/speech-recognition (missing from the published package, needed for this project's SPM-only iOS build).");
-- 
