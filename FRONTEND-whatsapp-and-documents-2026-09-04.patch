From bf2df2c8a958a73637a445f1f4494cb43fe56abb Mon Sep 17 00:00:00 2001
From: Usty <usty@uase.tech>
Date: Sun, 13 Sep 2026 08:41:56 +0000
Subject: [PATCH 10/12] fix: multi-page JPG download only delivered the first
 page - real browser limitation, now fixed with a threshold-based approach

Real, confirmed root cause: looping separate downloadBlob calls for
each page triggers multiple browser download actions in rapid
succession. Browsers (Chrome especially) silently block all but the
first automatic download in a row as a built-in anti-spam
protection against scripts - this wasn't a generation bug (the code
was already correctly producing every page's image), it was a
browser delivery limitation nobody had hit before because ID cards
(the one other place this mattered) always uses exactly 2 files with
an existing, documented 400ms delay between them that avoids
triggering the block.

New threshold-based fix in downloadBlobs:
- 2 files: reuses that exact same proven delay pattern already
  working reliably for ID card front/back downloads, labeled
  'front'/'back' to match - appropriate for a short 2-page receipt or
  invoice, where two clearly-labeled files feel right and a zip
  archive would be overkill for something this small.
- 3+ files: bundles into a single .zip instead - per-file delays
  become slow and less reliable to wait through as the page count
  grows, and a zip sidesteps the browser's multi-download blocking
  entirely regardless of how many pages are inside it. Matches what
  was specifically asked for the general financial report case.

Checked shareBlobs too before concluding it needed the same fix - it
doesn't: the web Share API genuinely supports multiple files in a
single navigator.share() call (one action, not multiple separate
download triggers, so it was never subject to this same browser
block), and the native single-file limitation was already being
handled honestly with a note to the user rather than silently
dropping pages. No changes needed there.

Added jszip as a new dependency for the zip-bundling path.
---
 lib/documentExport.ts | 27 ++++++++++++++++++++++++++-
 package.json          |  1 +
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/lib/documentExport.ts b/lib/documentExport.ts
index 5a9e6ef..71642d9 100644
--- a/lib/documentExport.ts
+++ b/lib/documentExport.ts
@@ -1,6 +1,7 @@
 import html2canvas from "html2canvas";
 import jsPDF from "jspdf";
 import * as XLSX from "xlsx";
+import JSZip from "jszip";
 
 /**
  * Real, working PDF/Excel generation + native download + native share —
@@ -436,12 +437,36 @@ export async function downloadBlobs(blobs: Blob[], baseFilename: string): Promis
     await downloadBlob(blobs[0], baseFilename);
     return;
   }
+
   const dotIndex = baseFilename.lastIndexOf(".");
   const stem = dotIndex >= 0 ? baseFilename.slice(0, dotIndex) : baseFilename;
   const ext = dotIndex >= 0 ? baseFilename.slice(dotIndex) : "";
+  const pageLabel = (i: number) => blobs.length === 2 ? (i === 0 ? "front" : "back") : `page${i + 1}`;
+
+  if (blobs.length === 2) {
+    // Same proven pattern already working reliably for ID card
+    // front/back downloads: a short gap between the two prevents the
+    // second one from being silently blocked by browsers/WebViews
+    // that treat rapid successive programmatic downloads similarly
+    // to popup spam. Matches what a short document (a 2-page
+    // receipt/invoice) should feel like - two clearly-labeled files,
+    // not a zip archive for something this small.
+    await downloadBlob(blobs[0], `${stem}-${pageLabel(0)}${ext}`);
+    await new Promise(resolve => setTimeout(resolve, 400));
+    await downloadBlob(blobs[1], `${stem}-${pageLabel(1)}${ext}`);
+    return;
+  }
+
+  // 3+ pages: bundle into a single .zip rather than looping more
+  // downloads - per-file delays become slow and less reliable as the
+  // count grows, and a zip sidesteps the browser's multi-download
+  // blocking entirely regardless of how many pages are inside it.
+  const zip = new JSZip();
   for (let i = 0; i < blobs.length; i++) {
-    await downloadBlob(blobs[i], `${stem}-page${i + 1}${ext}`);
+    zip.file(`${stem}-page${i + 1}${ext}`, blobs[i]);
   }
+  const zipBlob = await zip.generateAsync({ type: "blob" });
+  await downloadBlob(zipBlob, `${stem}.zip`);
 }
 
